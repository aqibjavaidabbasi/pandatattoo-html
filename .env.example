# Copy to .env (gitignored) and fill in. Never commit real values.

# --- Contentful ---
# Rotate the tokens that were hardcoded in the old functions.php before using these.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_CDA_TOKEN=
CONTENTFUL_CMA_TOKEN=

# --- Analytics (see TRACKING.md) ---
GTM_ID=GTM-M3WW4NT7
GA4_ID=G-YBBGK3PZCZ
META_PIXEL_ID=2148964251981412

# --- Voting (tattoo-fight) ---
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# --- Mail (OTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Site ---
# Base for every URL the site emits (assets, stylesheets, routes) — fully qualified,
# and it MUST include the subfolder if the app is not at the domain root.
# Leave it BLANK to derive the base from the request instead (scheme + Host + the app's
# directory under the document root). Blank is what you want for local `php -S` work;
# set it on staging and production.
SITE_URL=https://staging4.temp.tattoopanda.com

# Pretty URLs (/gallery/) need mod_rewrite AND an .htaccess the host actually honours.
# Inside another site's document root that is not a given — the parent site's rewrite
# rules can swallow the request instead. Left at 0, links point straight at real files
# (/gallery.php) and nothing depends on a rewrite.
# Flip to 1 only after confirming https://<host>/<subfolder>/gallery/ serves the page.
PRETTY_URLS=0
